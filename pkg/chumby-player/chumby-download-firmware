#!/usr/bin/env python3
"""chumby-download-firmware — fetch the files the package cannot ship.

The control panel, intro tour, boot animation and alarm tones are
copyrighted Chumby Industries firmware, so the Debian package does not
contain them. Chumby's own servers still do: the classic 1.7.3 firmware
image (update.zip, ~30 MB) carries everything but the newest control
panel, and chumby.com serves that panel through the same protocol the
original firmware's download_cp used. It installs either that panel or
the Sony Dash's, whose 860x480 layout suits larger screens; chumby
still serves the Dash panel and its default theme too. This helper shows
exactly what it would download and asks before touching the network.
Nothing identifying
is sent (the device id in the control-panel query is zeroed), and the
player itself stays offline afterwards.

The boot animation (opening.swf) is rasterized into a Plymouth theme,
which needs root (the theme lives under /usr/share/plymouth/themes/);
that one step asks separately and uses sudo, unlike the rest of this
script.
"""

import hashlib
import io
import os
import shutil
import subprocess
import sys
import tempfile
import urllib.request
import xml.etree.ElementTree as ET
import zipfile
from pathlib import Path

STATE = Path(os.environ.get("CHUMBY_STATE", "/var/lib/chumby"))
SHARE = Path(os.environ.get("CHUMBY_SHARE", "/usr/share/chumby-player"))
# The panel's writable tree, seeded per panel; its platform file says
# which (ruffle fixtures/platform "ironforge", fixtures-dash/platform "yume").
FIXTURES = STATE / "fixtures"

UPDATE_URL = "https://files.chumby.com/resources/classic/1-7-3/update.zip"
UPDATE_MD5 = "3fa64d39777d27908586d51824bb0eb7"
# Inside the blob: a zip per partition; rfs1.bin is the CRAMFS rootfs.
RFS_MEMBER = "update2/rfs1.bin.zip"
RFS_NAME = "rfs1.bin"

# CRAMFS path in the 1.7.3 rootfs -> file under $STATE.
FIRMWARE_FILES = {
    "usr/widgets/intro.swf": "intro.swf",
    "usr/widgets/opening.swf": "opening.swf",
    "usr/chumby/alarmtones/Beep.mp3": "alarmtones/Beep.mp3",
    "usr/chumby/alarmtones/Bugle.mp3": "alarmtones/Bugle.mp3",
    "usr/chumby/alarmtones/ClockStrikes.mp3": "alarmtones/ClockStrikes.mp3",
    "usr/chumby/alarmtones/Gong.mp3": "alarmtones/Gong.mp3",
    "usr/chumby/alarmtones/Klaxon.mp3": "alarmtones/Klaxon.mp3",
    "usr/chumby/alarmtones/Nightingale.mp3": "alarmtones/Nightingale.mp3",
    "usr/chumby/alarmtones/RoosterCrow.mp3": "alarmtones/RoosterCrow.mp3",
}
# The blob's own control panel — 2.8.75, older than the 2.8.87b3 this
# project is verified against. Fallback only (see download_controlpanel).
BLOB_CONTROLPANEL = "usr/widgets/controlpanel.swf"

# opening.swf -> Plymouth boot theme (claude/issues.md #3). 132 frames,
# 12 fps, 320x240 — fixed values for this specific movie, not derived,
# since the theme script (pkg/chumby-player/plymouth-theme-chumby/) is
# written against exactly this asset.
BOOT_THEME_FRAME_COUNT = 132
PLYMOUTH_THEME_DIR = Path("/usr/share/plymouth/themes/chumby")
EXPORTER = Path(os.environ.get(
    "CHUMBY_EXPORTER", "/usr/lib/chumby-player/ruffle-exporter"))
# Plymouth only draws when `splash` is on the kernel command line —
# Raspberry Pi OS Lite ships without it (Full has it).
BOOT_CMDLINE = Path("/boot/firmware/cmdline.txt")
SPLASH_ARGS = "quiet splash plymouth.ignore-serial-consoles"

# The Sony Dash panel: Duane's 2023 build (forum thread 10301) — the
# package's own 4.10.0 lost its weather feed.
DASH_PANEL_URL = "http://files.chumby.com/yume/controlpanels/4_10_3/controlpanel.swf"
DASH_PANEL_MD5 = "d2354d700a7b4abe6abe037347b711b0"
# chumby's Dash package (thread 9843), for its default theme: without a
# theme the Dash has no home screen.
DASH_PACKAGE_URL = "http://files.chumby.com/dash/chumby/chumby-hidc10-1.0.0.zip"
DASH_PACKAGE_MD5 = "4fd7b88a993125a0c3d82aca8fe5673c"
# The clock widget the Dash's channel names, from the 1.7.3 image.
BUILTIN_CLOCK = "usr/widgets/builtinclock.swf"
# Dash tone -> classic tone "by character" (chumby-pi claude/issues.md 14);
# Sony's own tones were never on chumby's servers.
DASH_TONES = {
    "alarm1": "Beep", "alarm2": "Beep", "alarm3": "Klaxon",
    "alarm4": "ClockStrikes", "alarm5": "Gong", "alarm6": "Bugle",
    "Birds": "Nightingale", "Wave": "RoosterCrow",
}
# Event tones are the alarm tones under other names (Event.as:96-98).
DASH_EVENT_TONES = {f"event{i}": f"alarm{i}" for i in range(1, 7)} | {
    "Birds": "Birds", "Wave": "Wave"}

# The panel-download protocol of the original firmware's download_cp
# script. Identity params are deliberately zero/static: the server
# ignores them and answers with the newest build for the platform.
CP_QUERY = ("https://www.chumby.com/xml/controlpanel"
            "?id=00000000-0000-0000-0000-000000000000"
            "&hw=3.8&sw=1.7.2&fw=1.7.2&lang=en-us")


def fetch(url: str, timeout: int = 300) -> bytes:
    with urllib.request.urlopen(url, timeout=timeout) as resp:
        return resp.read()


def confirm(prompt: str) -> bool:
    try:
        answer = input(f"{prompt} [Y/n] ").strip().lower()
    except EOFError:
        return False
    return answer in ("", "y", "yes")


def save(path: Path, data: bytes) -> None:
    # 0644 no matter the umask: the player runs as user pi and a
    # root-only file yields a blank screen (the 0.8.1 lesson).
    path.parent.mkdir(parents=True, exist_ok=True)
    tmp = path.with_name(path.name + ".new")
    tmp.write_bytes(data)
    tmp.chmod(0o644)
    tmp.replace(path)
    print(f"  wrote {path} ({len(data)} bytes)")


def fetch_checked(url: str, md5: str) -> bytes:
    data = fetch(url)
    if hashlib.md5(data).hexdigest() != md5:
        sys.exit(f"{url}: md5 mismatch (expected {md5}) — not keeping the file.")
    return data


def sevenzip() -> str:
    for name in ("7zz", "7z", "7za"):
        if shutil.which(name):
            return name
    sys.exit("no 7-Zip binary found — install it with: sudo apt install 7zip")


def extract_rootfs(workdir: Path, dash: bool) -> Path | None:
    """Download update.zip, unpack the CRAMFS rootfs, return its tree."""
    wanted = {s: t for s, t in FIRMWARE_FILES.items()
              if not (dash and t == "intro.swf")}  # the tour is the classic's
    missing = [t for t in wanted.values() if not (STATE / t).is_file()]
    if dash and not (FIXTURES / "rootfs" / BUILTIN_CLOCK).is_file():
        missing.append(BUILTIN_CLOCK)
    if not missing:
        print("firmware files: all present, skipping update.zip.")
        return None

    print("The classic 1.7.3 firmware image provides intro.swf, opening.swf,")
    print("the alarm tones and the clock widget (a ~30 MB download):")
    print(f"  {UPDATE_URL}")
    if not confirm("Download it?"):
        print("  skipped.")
        return None

    blob = fetch(UPDATE_URL)
    if hashlib.md5(blob).hexdigest() != UPDATE_MD5:
        sys.exit(f"md5 mismatch (expected {UPDATE_MD5}) — not keeping the file.")
    blob_path = workdir / "update.zip"
    blob_path.write_bytes(blob)

    with zipfile.ZipFile(blob_path) as z:
        z.extract(RFS_MEMBER, workdir)
    with zipfile.ZipFile(workdir / RFS_MEMBER) as z:
        z.extract(RFS_NAME, workdir)

    # Only the two firmware directories: elsewhere the image's busybox
    # symlinks make 7-Zip exit nonzero ("dangerous link path").
    tree = workdir / "rootfs"
    subprocess.run([sevenzip(), "x", "-y", f"-o{tree}", str(workdir / RFS_NAME),
                    "usr/widgets", "usr/chumby/alarmtones"],
                   check=True, stdout=subprocess.DEVNULL)

    for src, target in wanted.items():
        dest = STATE / target
        if dest.is_file():
            print(f"  {dest} already present, kept.")
            continue
        save(dest, (tree / src).read_bytes())
    return tree


def download_controlpanel(rootfs: Path | None) -> None:
    target = STATE / "controlpanel.swf"
    if target.is_file():
        print(f"controlpanel.swf: already at {target}, skipping.")
        return

    print("controlpanel.swf: chumby.com serves the newest build (2.8.87b3),")
    print("the one this player is tested against — recommended.")
    try:
        meta = ET.fromstring(fetch(CP_QUERY, timeout=30))
        url = meta.findtext("url", "")
        md5 = meta.findtext("md5", "")
        build = meta.get("build", "?")
    except OSError as e:
        print(f"  chumby.com query failed ({e}).")
        url = md5 = ""
        build = "?"
    if url and md5:
        print(f"controlpanel.swf, build {build}:")
        print(f"  {url}")
        if confirm("Download it?"):
            data = fetch(url)
            if hashlib.md5(data).hexdigest() != md5:
                sys.exit(f"md5 mismatch (expected {md5}) — not keeping the file.")
            save(target, data)
            return
        print("  skipped.")

    # Last resort: the 1.7.3 image's own panel. Runs, but it is not the
    # build this project verifies against (claude-docs/development.md).
    if rootfs is not None:
        print("The firmware image carries an older panel (2.8.75). It works,")
        print("but this project is tested against 2.8.87b3 only.")
        if confirm("Use the 2.8.75 panel from the image instead?"):
            save(target, (rootfs / BLOB_CONTROLPANEL).read_bytes())


def installed_platform() -> str | None:
    panel = STATE / "controlpanel.swf"
    if panel.is_file():
        dash = hashlib.md5(panel.read_bytes()).hexdigest() == DASH_PANEL_MD5
        return "yume" if dash else "ironforge"
    if not FIXTURES.is_dir():
        return None
    try:
        return (FIXTURES / "platform").read_text().strip()
    except OSError:
        return "ironforge"  # trees from before the Dash are all classic


def switch_panel(platform: str) -> None:
    """Remove the other panel, its intro and its tree (with its settings)."""
    installed = installed_platform()
    if installed is None or installed == platform:
        return
    print("Another panel is installed. Switching removes it, the intro and")
    print(f"its settings (alarms, clock, weather) in {FIXTURES}.")
    if not confirm("Switch panels?"):
        sys.exit("Nothing changed.")
    for f in ("controlpanel.swf", "intro.swf"):
        (STATE / f).unlink(missing_ok=True)
    shutil.rmtree(FIXTURES, ignore_errors=True)
    print("  removed the previous panel.")


def install_dash(rootfs: Path | None) -> None:
    """The Dash panel and what its tree needs: theme, clock, tones."""
    if not FIXTURES.is_dir():
        seed = STATE / "fixtures.seed"
        shutil.copytree(SHARE / "fixtures-dash", seed, symlinks=True)
        seed.rename(FIXTURES)
        print(f"  seeded {FIXTURES} for the Dash.")
    rootfs_dir = FIXTURES / "rootfs"
    if rootfs is not None:
        save(rootfs_dir / BUILTIN_CLOCK, (rootfs / BUILTIN_CLOCK).read_bytes())

    panel = STATE / "controlpanel.swf"
    theme = rootfs_dir / "psp/theme.swf"
    if panel.is_file() and theme.is_file():
        print("Dash panel and theme: already installed, skipping.")
    else:
        print("The Sony Dash panel 4.10.3 and chumby's Dash package (for")
        print("its default theme, Space Theme):")
        print(f"  {DASH_PANEL_URL}")
        print(f"  {DASH_PACKAGE_URL}")
        if not confirm("Download them?"):
            print("  skipped.")
            return
        if not theme.is_file():
            with zipfile.ZipFile(io.BytesIO(
                    fetch_checked(DASH_PACKAGE_URL, DASH_PACKAGE_MD5))) as z:
                # A copy, not a link: installing a theme writes this path.
                save(theme, z.read("default_theme.swf"))
                save(rootfs_dir / "psp/theme_name.txt", z.read("default_theme_name.txt"))
        save(panel, fetch_checked(DASH_PANEL_URL, DASH_PANEL_MD5))

    # The launcher links the tree's alarmtones to $STATE/alarmtones.
    tones = STATE / "alarmtones"
    for dash, classic in DASH_TONES.items():
        target = tones / f"{dash}.mp3"
        if not target.is_file() and (tones / f"{classic}.mp3").is_file():
            save(target, (tones / f"{classic}.mp3").read_bytes())
    for event, alarm in DASH_EVENT_TONES.items():
        target = rootfs_dir / "usr/chumby/eventtones" / f"{event}.mp3"
        if not target.is_file() and (tones / f"{alarm}.mp3").is_file():
            save(target, (tones / f"{alarm}.mp3").read_bytes())


def install_boot_theme() -> None:
    """Rasterize opening.swf into the Plymouth theme and activate it.

    Needs root (the theme lives under /usr/share/plymouth/themes/), so
    this is the one step in the script that shells out to sudo — everything
    else here runs, and writes, as the invoking user.
    """
    frames_dir = PLYMOUTH_THEME_DIR / "frames"
    if (frames_dir / f"frame-{BOOT_THEME_FRAME_COUNT - 1}.png").is_file():
        print("boot animation: Plymouth theme already installed, skipping.")
        enable_splash()
        return

    opening = STATE / "opening.swf"
    if not opening.is_file():
        print("boot animation: no opening.swf, skipping (re-run after")
        print("  downloading it above).")
        return

    if not EXPORTER.is_file():
        print(f"boot animation: {EXPORTER} not found — is chumby-player")
        print("  installed? skipping.")
        return

    print("boot animation: rasterizing opening.swf into a Plymouth theme")
    print(f"  and installing it to {PLYMOUTH_THEME_DIR} (needs sudo).")
    if not confirm("Install it?"):
        print("  skipped.")
        return

    with tempfile.TemporaryDirectory(prefix="chumby-boot-theme-") as tmp:
        raw = Path(tmp) / "raw"
        staged = Path(tmp) / "staged"
        staged.mkdir()
        subprocess.run([str(EXPORTER), str(opening), str(raw), "--frames", "all"],
                        check=True)

        frames = sorted(raw.glob("*.png"), key=lambda p: int(p.stem))
        if len(frames) != BOOT_THEME_FRAME_COUNT:
            sys.exit(f"boot animation: expected {BOOT_THEME_FRAME_COUNT} frames, "
                      f"exporter produced {len(frames)} — not installing.")
        for frame in frames:
            frame.rename(staged / f"frame-{int(frame.stem)}.png")

        subprocess.run(["sudo", "mkdir", "-p", str(frames_dir)], check=True)
        subprocess.run(["sudo", "cp", "-t", str(frames_dir), *[
            str(staged / f.name) for f in staged.iterdir()]], check=True)
        # -R rebuilds the initramfs: plymouth starts from there (RPi OS
        # ships auto_initramfs=1), and without the rebuild the early-boot
        # copy only carries the text fallback themes, never this one.
        subprocess.run(["sudo", "plymouth-set-default-theme", "-R", "chumby"],
                        check=True)
    print(f"  installed and activated ({BOOT_THEME_FRAME_COUNT} frames).")
    enable_splash()


def enable_splash() -> None:
    """Put `splash` on the kernel command line if it is missing.

    Raspberry Pi OS Lite ships without it, and Plymouth never draws
    then — the theme would be installed but invisible.
    """
    try:
        cmdline = BOOT_CMDLINE.read_text()
    except OSError:
        print(f"  note: {BOOT_CMDLINE} not found — put 'splash' on the")
        print("  kernel command line yourself or the animation never shows.")
        return
    if "splash" in cmdline.split():
        return

    print(f"  Your kernel command line lacks 'splash' — without it Plymouth")
    print(f"  never draws. This appends: {SPLASH_ARGS}")
    if not confirm(f"Update {BOOT_CMDLINE} (backup kept)?"):
        print("  skipped — the theme is installed but will not show.")
        return
    subprocess.run(["sudo", "cp", str(BOOT_CMDLINE),
                    f"{BOOT_CMDLINE}.bak-chumby"], check=True)
    new = cmdline.rstrip("\n") + f" {SPLASH_ARGS}\n"
    subprocess.run(["sudo", "tee", str(BOOT_CMDLINE)], input=new.encode(),
                    check=True, stdout=subprocess.DEVNULL)
    print(f"  updated (original at {BOOT_CMDLINE}.bak-chumby).")


def main() -> None:
    print(__doc__)
    print(f"Files go to {STATE}.")
    if not os.access(STATE.parent, os.W_OK) and not STATE.is_dir():
        sys.exit(f"{STATE} does not exist and is not creatable — "
                 "install chumby-player first (or run with sudo once).")

    print("Which control panel?")
    print("  1  chumby classic (320x240)")
    print("  2  Sony Dash (860x480 — suits larger screens)")
    try:
        choice = input("Panel [1]: ").strip() or "1"
    except EOFError:
        choice = "1"
    if choice not in ("1", "2"):
        sys.exit(f"no panel {choice!r} — run again and answer 1 or 2.")
    dash = choice == "2"
    switch_panel("yume" if dash else "ironforge")

    with tempfile.TemporaryDirectory(prefix="chumby-fw-") as tmp:
        rootfs = extract_rootfs(Path(tmp), dash)
        print()
        if dash:
            install_dash(rootfs)
        else:
            download_controlpanel(rootfs)

    print()
    install_boot_theme()

    if not dash:
        print()
        print("Widgets are optional — without any, the panel is a clock.")
        print("To add some, put .swf files (plus .jpg/.png previews) into")
        print(f"{STATE}/widgets — e.g. copied from a chumby backup's")
        print("/usr/widgets — then run chumby-local-widgets.")
    print()
    print("Start (or restart) the panel:  sudo systemctl restart chumby-player")


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit("\nAborted.")
    except urllib.error.URLError as e:
        sys.exit(f"download failed: {e}")
