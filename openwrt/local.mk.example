# Copy to local.mk and fill in. local.mk is gitignored.
#
# Wifi is deliberately not configured here. The image ships with no radio
# settings; join the house network from LuCI (http://192.168.7.1 over the
# USB-gadget LAN) after first boot, and assign it the pre-made "wwan"
# interface so it lands in the wan firewall zone.

# Public keys that get root over ssh. Key-only auth — no root password.
ROOT_AUTHORIZED_KEYS = $(HOME)/.ssh/id_ed25519.pub

# Where the raw image lands.
# OUT = /tmp/fw.bin
