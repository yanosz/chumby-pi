# LuCI is bound to the LAN address, not 0.0.0.0. The wan zone accepts all
# input by design, and root has no password on a fresh image, so an
# all-interfaces admin UI would be an unauthenticated way in from the wifi —
# a network that cannot be treated as trusted. Reachable over the USB gadget
# only; ssh (key-only) remains the wifi-side entry.
#
# Tied to network.lan.ipaddr — change both together.
config uhttpd 'main'
	list listen_http '192.168.7.1:80'
	option home '/www'
	option cgi_prefix '/cgi-bin'
	option rfc1918_filter '1'
	option max_requests '3'
	option max_connections '100'
	option script_timeout '60'
	option network_timeout '30'
	option http_keepalive '20'
	option tcp_keepalive '1'
